% Rules

% Find Faculty Teaching a Subject
teaches(Faculty, Subject) :-
    faculty(Faculty, Department),
    subject(Subject, Department).

% Find Classroom of a Subject
room_of(Subject, Room) :-
    classroom(Subject, Room).

% Find Classes on a Particular Day
classes_on(Day, Subject, Time, Room) :-
    timetable(Day, Subject, Time, Room).

% Find Faculty of a Subject
faculty_of(Subject, Faculty) :-
    teaches(Faculty, Subject).
