% Experiment 6: Breadth-First Search (BFS)

% Graph Edges
edge(a, b).
edge(a, c).
edge(b, d).
edge(b, e).
edge(c, f).
edge(c, g).
edge(d, h).
edge(e, h).
edge(f, h).
edge(g, h).

% Undirected Graph
connected(X, Y) :- edge(X, Y).
connected(X, Y) :- edge(Y, X).

% BFS Algorithm
bfs(Start, Goal, Path) :-
    bfs_queue([[Start]], Goal, ReversePath),
    reverse(ReversePath, Path).

% Goal Reached
bfs_queue([[Goal|Rest]|_], Goal, [Goal|Rest]).

% Continue Searching
bfs_queue([Path|Queue], Goal, Result) :-
    Path = [Current|_],
    findall(
        [Next|Path],
        (connected(Current, Next),
         \+ member(Next, Path)),
        NewPaths
    ),
    append(Queue, NewPaths, UpdatedQueue),
    bfs_queue(UpdatedQueue, Goal, Result).
