% Experiment 2: Arithmetic Operations, Factorial and Fibonacci

% Basic Arithmetic Operations

addition(A, B, Result) :-
    Result is A + B.

subtraction(A, B, Result) :-
    Result is A - B.

multiplication(A, B, Result) :-
    Result is A * B.

division(A, B, Result) :-
    B =\= 0,
    Result is A / B.

% Factorial of a Number

factorial(0, 1).

factorial(N, F) :-
    N > 0,
    N1 is N - 1,
    factorial(N1, F1),
    F is N * F1.

% Fibonacci Series

fibonacci(0, 0).

fibonacci(1, 1).

fibonacci(N, F) :-
    N > 1,
    N1 is N - 1,
    N2 is N - 2,
    fibonacci(N1, F1),
    fibonacci(N2, F2),
    F is F1 + F2.

% Generate Fibonacci Series

fib_series(0, [0]).

fib_series(N, List) :-
    N > 0,
    fib_list(0, 1, N, List).

fib_list(_, _, 0, []).

fib_list(A, B, N, [A|Rest]) :-
    N > 0,
    N1 is N - 1,
    C is A + B,
    fib_list(B, C, N1, Rest).
